{
  "name": "dsh-web-reader",
  "version": "0.1.0",
  "type": "module",
  "description": "Read JavaScript-rendered pages in full: takes over web_fetch with a real local browser and adds web_read for paginated reading of very long pages. · 完整读取 JS 渲染网页：本机真实浏览器接管 web_fetch，web_read 分段读超长页面。",
  "main": "index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "wangBilljCD",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangBilljCD/dsh-web-reader"
  },
  "homepage": "https://github.com/wangBilljCD/dsh-web-reader",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "web",
    "browser",
    "chrome",
    "reader"
  ],
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-web": ">=0.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
